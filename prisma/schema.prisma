// Prisma schema: the single source of truth for the database.
// Each `model` becomes a table. After changing this file, run:
//   npm run db:migrate
// which creates a migration (SQL file) and regenerates the typed client.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The connection URL lives in prisma.config.ts (read from .env).
datasource db {
  provider = "sqlite"
}

// ─── Enums ──────────────────────────────────────────────────────────────────
// A fixed list of allowed values. Prisma rejects anything else.

enum Role {
  CUSTOMER // browses and reserves bags
  STORE_OWNER // lists surplus food for their stores
  ADMIN
}

enum BagCategory {
  MEALS
  BAKERY
  GROCERIES
  PRODUCE
  MIXED
}

enum OrderStatus {
  PENDING_PAYMENT // bag is held while the customer pays (see Order.expiresAt)
  RESERVED // paid, waiting for pickup
  COLLECTED // customer picked it up
  CANCELLED // cancelled by the customer (paid orders are refunded)
  EXPIRED // not paid in time, or payment failed; the bag went back on sale
  NO_SHOW // paid, but the customer didn't collect it (store marked it); not refunded
}

enum StoreStatus {
  PENDING // new store, waiting for an admin to check it; invisible to customers
  APPROVED // visible to customers
  REJECTED // not approved (or hidden later); Store.rejectionReason says why
}

enum PaymentStatus {
  PENDING // customer is on the payment page
  PAID
  FAILED // declined or abandoned
  REFUNDED
}

// ─── Models ─────────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String // never store plain-text passwords
  role           Role      @default(CUSTOMER)
  // Proof of consent to the terms and personal data processing (required by
  // Kazakhstan's personal data law). Version = LEGAL_VERSION in src/content/legal.
  consentAt      DateTime?
  consentVersion String?
  // Account deleted by its owner: personal details are wiped (name, email,
  // password), order history is kept anonymously. See deleteAccount.
  deletedAt      DateTime?
  blockedAt      DateTime? // blocked by an admin: can't log in
  blockedReason  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relation fields: not real columns, they let you write
  // `prisma.user.findUnique({ include: { orders: true } })`.
  stores            Store[] // stores this user owns (if STORE_OWNER)
  orders            Order[] // bags this user has reserved
  sessions          Session[] // one per device the user is logged in on
  passwordResets    PasswordResetToken[]
  favorites         Favorite[]
  pushSubscriptions PushSubscription[]
  adminLogs         AdminLog[] // actions taken as an admin
}

// A device (phone/computer browser) that asked for push notifications.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique // the browser's push address
  p256dh    String // encryption keys from the browser
  auth      String
  locale    String   @default("ru") // language of the notifications
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A customer's favourite store (♡).
model Favorite {
  createdAt  DateTime  @default(now())
  notifiedAt DateTime? // last "new bag" push for this store, at most one per 12 hours

  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId]) // a store can be favourited once per user
  @@index([storeId])
}

// "Forgot password?" links. Like sessions, only a hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime? // a link works once
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Failed logins and reset requests, for rate limiting (see src/lib/rate-limit.ts).
// key is a normalized email or an IP address.
model AuthAttempt {
  id        String   @id @default(cuid())
  kind      String // "login" | "login-ip" | "reset"
  key       String
  createdAt DateTime @default(now())

  @@index([kind, key, createdAt])
}

// A logged-in browser. The browser keeps a random token in a cookie; we store
// only a SHA-256 hash of it, so a leaked database can't be used to log in.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Store {
  id           String   @id @default(cuid())
  name         String
  description  String?
  address      String
  searchText   String   @default("") // lowercased name + description + address, see src/lib/search.ts
  city         String
  latitude     Float? // optional, for "near me" sorting
  longitude    Float?
  imageUrl     String?
  phone        String? // "+77011234567" (see src/lib/phone.ts); required in the form
  openingHours String? // free text, e.g. "Пн–Пт 08:00–20:00"
  // Yearly fee (src/lib/fees.ts). The first stores approved get a free year.
  foundingNumber Int? // 1–50 for the first stores approved ("founding partners")
  feeFreeUntil   DateTime? // end of the free year
  feePaidUntil   DateTime? // yearly fee paid up to here
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Admin review: only APPROVED stores' bags are shown to customers.
  status          StoreStatus @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?

  // Foreign key: each store belongs to one user (its owner).
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  bags      SurpriseBag[]
  schedules BagSchedule[]
  favorites Favorite[]
  reviews   Review[]
  membershipPayments MembershipPayment[]

  @@index([ownerId])
  @@index([city])
  @@index([status])
}

model SurpriseBag {
  id          String      @id @default(cuid())
  title       String
  description String?
  searchText  String      @default("") // lowercased title + description, see src/lib/search.ts
  category    BagCategory @default(MIXED)
  imageUrl    String?

  // Money is stored in tiyn (1/100 tenge) as whole numbers (Int), never
  // Float, to avoid rounding errors like 0.1 + 0.2 = 0.30000000000000004.
  originalPrice Int // e.g. 450000 = 4 500 ₸ worth of food
  price         Int // e.g. 149000 = 1 490 ₸ the customer pays

  // Food labels set by the store (see src/lib/labels.ts).
  isHalal      Boolean @default(false)
  isVegetarian Boolean @default(false)
  isVegan      Boolean @default(false) // vegan bags are always vegetarian too
  allergens    String  @default("") // "may contain", comma-separated codes, e.g. "GLUTEN,MILK"

  quantityAvailable Int      @default(1) // goes down as orders come in
  pickupStart       DateTime
  pickupEnd         DateTime
  isActive          Boolean  @default(true) // store can hide a listing
  hiddenByAdminAt   DateTime? // hidden by an admin; the store can't put it back on sale
  packReminderSentAt DateTime? // "pack N bags" push sent to the store (src/lib/reminders.ts)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  orders Order[]

  // Bags published automatically from a regular schedule: which schedule,
  // and for which day ("2026-10-02", Kazakhstan time).
  scheduleId   String?
  schedule     BagSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  scheduleDate String?

  @@unique([scheduleId, scheduleDate]) // one bag per schedule per day
  @@index([storeId])
  @@index([isActive, pickupEnd]) // speeds up "available right now" queries
}

// A regular bag ("every Mon–Fri, 18:00–20:00, 5 bags"). The app publishes a
// SurpriseBag from it for today and tomorrow (see src/lib/schedules.ts).
model BagSchedule {
  id            String      @id @default(cuid())
  title         String
  description   String?
  category      BagCategory @default(MIXED)
  imageUrl      String?
  isHalal       Boolean     @default(false)
  isVegetarian  Boolean     @default(false)
  isVegan       Boolean     @default(false)
  allergens     String      @default("")
  originalPrice Int // tiyn
  price         Int // tiyn
  quantity      Int // bags per day
  weekdays      String // ISO weekdays, 1 = Monday … 7 = Sunday, e.g. "1,2,3,4,5"
  startTime     String // "18:00", Kazakhstan time
  endTime       String // "20:00"; earlier than startTime = after midnight
  isActive      Boolean     @default(true) // paused schedules publish nothing
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  bags SurpriseBag[]

  @@index([storeId])
}

model Order {
  id          String      @id @default(cuid())
  quantity    Int         @default(1)
  totalPrice  Int // tiyn; copied at purchase time so later price edits don't change history
  status      OrderStatus @default(PENDING_PAYMENT)
  pickupCode  String      @unique // short code the customer shows at the store
  expiresAt   DateTime? // payment deadline while PENDING_PAYMENT
  cancelledBy String? // CANCELLED orders: "customer", "store" or "admin"
  reminderSentAt DateTime? // "pickup starts soon" push sent
  cancelReason String? // store cancellations: "SOLD_OUT", "CLOSING" or "OTHER" (shown to the customer)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Restrict: a bag that has orders can't be deleted (keeps order history intact).
  bagId String
  bag   SurpriseBag @relation(fields: [bagId], references: [id], onDelete: Restrict)

  payment Payment?
  review  Review?
  report  ProblemReport?

  @@index([userId])
  @@index([bagId])
  @@index([status, expiresAt]) // finding unpaid orders past their deadline
}

// The money side of an order. Amounts are in tiyn, like prices.
model Payment {
  id                String        @id @default(cuid())
  provider          String // "test" for now; later "kaspi" or "halyk"
  providerPaymentId String? // the provider's own ID, for refunds and support
  amount            Int
  currency          String        @default("KZT")
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  refundedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPaymentId])
}

// A customer's 1–5 star rating of a collected order. One per order.
// The comment is only shown to the store and admins.
model Review {
  id        String   @id @default(cuid())
  rating    Int // 1–5
  comment   String?
  createdAt DateTime @default(now())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Copied from the order's bag so a store's average is one simple query.
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

// "Report a problem" with an order. An admin looks at it and either refunds
// the customer or closes it. One per order.
model ProblemReport {
  id         String    @id @default(cuid())
  kind       String // QUALITY, NOT_AS_DESCRIBED, NO_FOOD, OTHER (src/lib/feedback.ts)
  text       String
  status     String    @default("OPEN") // OPEN, REFUNDED, CLOSED
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
}

// What admins did, for accountability: approvals, refunds, blocks, hidden bags…
model AdminLog {
  id         String   @id @default(cuid())
  action     String // e.g. "store.approve", "user.block", "bag.hide", "report.refund"
  targetType String // "store", "user", "bag", "order", "report"
  targetId   String
  details    String? // human-readable: the store's name, a reason…
  createdAt  DateTime @default(now())

  adminId String
  admin   User   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

// "Become a partner" requests from the /partners page. An admin calls them
// back and marks them CONTACTED or CLOSED.
model PartnerRequest {
  id          String    @id @default(cuid())
  storeName   String
  contactName String
  phone       String // normalised, e.g. +77011234567
  email       String?
  city        String // ALMATY / ASTANA (src/lib/cities.ts)
  kind        String // BAKERY, CAFE, RESTAURANT, SHOP, OTHER
  message     String?
  status      String    @default("NEW") // NEW, CONTACTED, CLOSED
  createdAt   DateTime  @default(now())
  handledAt   DateTime?

  @@index([status])
}

// A yearly fee a store paid (outside the app for now: bank transfer, Kaspi),
// recorded by an admin. Extends Store.feePaidUntil by a year.
model MembershipPayment {
  id          String   @id @default(cuid())
  amount      Int // tiyn
  paidAt      DateTime @default(now())
  coversUntil DateTime // the store's new feePaidUntil
  adminId     String // who recorded it (see AdminLog too)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([paidAt])
}
